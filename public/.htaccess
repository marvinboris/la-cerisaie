# Hébergement LWS (Apache). Réplique vercel.json : URL propres, fallback SPA, cache, sécurité.
Options -MultiViews -Indexes
AddDefaultCharset UTF-8

AddType video/mp4 .mp4
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS et www → apex, en une seule redirection.
  # X-Forwarded-Proto : évite une boucle si LWS termine le TLS en amont.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://lacerisaie-eyeclinic.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lacerisaie-eyeclinic.com%{REQUEST_URI} [L,R=301]

  # /page.html → /page (URL canonique sans extension)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # /page → page.html quand le fichier prérendu existe
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ /$1.html [L]
</IfModule>

# URL inconnue : vrai 404 + coquille SPA qui affiche la page 404 React
ErrorDocument 404 /shell.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # HTML toujours revalidé : un déploiement doit être visible immédiatement
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Assets hachés par Vite : cache un an
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Images, vidéos, polices : un mois
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|mp4|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
